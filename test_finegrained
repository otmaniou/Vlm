# ============================================================
# DIAGNOSTIC FP8 DU PREMIER GATE_PROJ
# ============================================================

layer = model.model.language_model.layers[0].mlp.gate_proj

print("=== GATE_PROJ LAYER 0 ===")
print("Type :", type(layer))

print("\n=== ATTRIBUTS ===")
for attr in [
    "weight",
    "weight_scale",
    "weight_scale_inv",
    "input_scale",
    "input_scale_inv",
    "bias"
]:
    if hasattr(layer, attr):
        obj = getattr(layer, attr)

        if obj is None:
            print(attr, "= None")
        else:
            print(
                attr,
                "| type =", type(obj),
                "| shape =", getattr(obj, "shape", None),
                "| dtype =", getattr(obj, "dtype", None),
                "| device =", getattr(obj, "device", None)
            )
    else:
        print(attr, "= ABSENT")


print("\n=== STATE_DICT ===")

for name, tensor in layer.state_dict().items():
    print(
        name,
        "| shape =", tuple(tensor.shape),
        "| dtype =", tensor.dtype,
        "| device =", tensor.device
    )


print("\n=== POIDS ===")

w = layer.weight

print("weight dtype :", w.dtype)
print("weight shape :", tuple(w.shape))
print("weight device:", w.device)
print("is_floating_point :", w.is_floating_point())

print("\n=== CONFIG QUANTIZATION ===")

qc = getattr(model.config, "quantization_config", None)

print("quantization_config :", qc)

if qc is not None:
    try:
        print(qc.to_dict())
    except:
        print(vars(qc))
