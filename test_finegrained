# Diagnostic des poids/scales FP8

layer = model.language_model.layers[0].mlp.gate_proj

print("=== GATE_PROJ LAYER 0 ===")
print("Type :", type(layer))

print("\nAttributs intéressants :")
for name in dir(layer):
    if "scale" in name.lower() or "weight" in name.lower():
        try:
            obj = getattr(layer, name)

            if torch.is_tensor(obj):
                print(
                    name,
                    "| shape =", tuple(obj.shape),
                    "| dtype =", obj.dtype,
                    "| device =", obj.device
                )
            else:
                print(name, "=", obj)

        except Exception as e:
            print(name, "-> erreur :", e)

print("\n=== STATE DICT ===")
for name, tensor in layer.state_dict().items():
    print(
        name,
        "| shape =", tuple(tensor.shape),
        "| dtype =", tensor.dtype
    )
