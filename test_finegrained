import sys
import importlib.util
from pathlib import Path

KERNEL_DIR = Path("/mnt/finegrained-fp8/build/torch-cuda")

print("Kernel dir :", KERNEL_DIR)
print("Existe     :", KERNEL_DIR.exists())

if not KERNEL_DIR.exists():
    raise FileNotFoundError(KERNEL_DIR)

# Charger le dossier comme un vrai package Python
package_name = "local_finegrained_fp8"

spec = importlib.util.spec_from_file_location(
    package_name,
    KERNEL_DIR / "__init__.py",
    submodule_search_locations=[str(KERNEL_DIR)]
)

local_fp8_kernel = importlib.util.module_from_spec(spec)

# Très important pour que les imports relatifs fonctionnent
sys.modules[package_name] = local_fp8_kernel

spec.loader.exec_module(local_fp8_kernel)

print("\nKERNEL CHARGE")
print("Module :", local_fp8_kernel)
print("Fichier:", local_fp8_kernel.__file__)

print("\nFonctions disponibles :")
print("matmul         :", getattr(local_fp8_kernel, "matmul", None))
print("matmul_batched :", getattr(local_fp8_kernel, "matmul_batched", None))
print("grouped_matmul :", getattr(local_fp8_kernel, "grouped_matmul", None))
