import sys
import importlib

KERNEL_PATH = "/mnt/finegrained-fp8/build/torch-cuda"

# Ajouter le kernel local à Python
if KERNEL_PATH not in sys.path:
    sys.path.insert(0, KERNEL_PATH)

# Charger le kernel
local_fp8_kernel = importlib.import_module("finegrained_fp8")

print("Kernel chargé depuis :", local_fp8_kernel.__file__)

# Vérifier les 3 fonctions nécessaires
for name in ["matmul_2d", "matmul_batched", "matmul_grouped"]:
    print(name, ":", hasattr(local_fp8_kernel, name))



import transformers.integrations.finegrained_fp8 as fp8

# Remplacer le chargement Hugging Face par notre kernel local
fp8.lazy_load_kernel = lambda *args, **kwargs: local_fp8_kernel

# Vider le cache du précédent échec
fp8._load_finegrained_fp8_kernel.cache_clear()

print("Patch Transformers installé")
