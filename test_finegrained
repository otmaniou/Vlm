calls = {
    "matmul": 0,
    "matmul_batched": 0,
    "grouped_matmul": 0
}

original_matmul = local_fp8_kernel.matmul
original_matmul_batched = local_fp8_kernel.matmul_batched
original_grouped_matmul = local_fp8_kernel.grouped_matmul


def traced_matmul(*args, **kwargs):
    calls["matmul"] += 1
    return original_matmul(*args, **kwargs)


def traced_matmul_batched(*args, **kwargs):
    calls["matmul_batched"] += 1
    return original_matmul_batched(*args, **kwargs)


def traced_grouped_matmul(*args, **kwargs):
    calls["grouped_matmul"] += 1
    return original_grouped_matmul(*args, **kwargs)


local_fp8_kernel.matmul = traced_matmul
local_fp8_kernel.matmul_batched = traced_matmul_batched
local_fp8_kernel.grouped_matmul = traced_grouped_matmul

print("Compteurs FP8 installés.")











print("\n=== APPELS KERNEL FP8 ===")
print("matmul         :", calls["matmul"])
print("matmul_batched :", calls["matmul_batched"])
print("grouped_matmul :", calls["grouped_matmul"])
print("TOTAL          :", sum(calls.values()))



