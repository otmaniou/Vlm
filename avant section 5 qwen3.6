import os

# Ton Domino n'a pas nvcc : forcer le fallback Triton
os.environ["TRANSFORMERS_DISABLE_DEEPGEMM_LINEAR"] = "1"

import torch
from transformers import AutoProcessor, AutoModelForMultimodalLM

MODEL_PATH = "TON_CHEMIN_LOCAL_QWEN3.6-27B-FP8"

print("Torch :", torch.__version__)
print("CUDA :", torch.version.cuda)
print("GPU :", torch.cuda.get_device_name(0))

Ensuite charge exactement comme recommandé par Qwen/Hugging Face :

processor = AutoProcessor.from_pretrained(
    MODEL_PATH,
    local_files_only=True,
    trust_remote_code=True
)

model = AutoModelForMultimodalLM.from_pretrained(
    MODEL_PATH,
    local_files_only=True,
    trust_remote_code=True,
    device_map="auto",
    dtype="auto"
)

model.eval()

print("MODEL OK")
print(type(model))

Puis ne teste pas encore le PDF. Teste :

messages = [
    {
        "role": "user",
        "content": [
            {
                "type": "text",
                "text": "Réponds uniquement par : BONJOUR OMAR"
            }
        ]
    }
]

inputs = processor.apply_chat_template(
    messages,
    add_generation_prompt=True,
    tokenize=True,
    return_dict=True,
    return_tensors="pt",
).to(model.device)

with torch.inference_mode():
    outputs = model.generate(
        **inputs,
        max_new_tokens=20,
        do_sample=False
    )

generated = outputs[0][inputs["input_ids"].shape[-1]:]

print(processor.decode(generated, skip_special_tokens=True))

C'est pratiquement le schéma de génération fourni officiellement pour Qwen3.6.

