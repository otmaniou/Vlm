from pathlib import Path
import pandas as pd

repertoire = Path("/transferts_in/les_ov_conso/PDF_SEPARES")

fichiers = sorted([f.name for f in repertoire.iterdir() if f.is_file()])

df = pd.DataFrame({
    "Fichier": fichiers,
    "nouveau_nom": ""
})

df.to_excel(repertoire / "liste_fichiers.xlsx", index=False)

print("Excel créé avec", len(df), "fichiers.")
