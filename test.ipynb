def norm_montant(v) -> float:
    if v is None:
        return None

    if isinstance(v, (int, float)):
        return float(v)

    s = str(v).strip()

    # Conserver uniquement chiffres, point et virgule
    # Ex : "124 244,00 DA" -> "124244,00"
    s = re.sub(r'[^\d,.]', '', s)

    if not s:
        return None

    # Cas avec POINT + VIRGULE
    if '.' in s and ',' in s:

        # Le dernier séparateur rencontré est considéré
        # comme le séparateur décimal.

        if s.rfind(',') > s.rfind('.'):
            # Format européen :
            # 124.244,00      -> 124244.00
            # 1.234.567,89    -> 1234567.89
            s = s.replace('.', '')
            s = s.replace(',', '.')

        else:
            # Format anglo-saxon :
            # 124,244.00      -> 124244.00
            # 1,234,567.89    -> 1234567.89
            s = s.replace(',', '')

    # Virgule seule : comportement V12 conservé
    elif s.count(',') == 1:
        # 348577,00 -> 348577.00
        s = s.replace(',', '.')

    # Plusieurs virgules sans point :
    # 1,234,567 -> 1234567
    elif s.count(',') > 1:
        s = s.replace(',', '')

    try:
        return float(s)
    except:
        return None
